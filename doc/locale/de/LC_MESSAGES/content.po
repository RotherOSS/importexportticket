#: ../content/index.rst:11
msgid ""
"Ticket backend for the ImportExport module. This backend allows to import "
"and export tickets with their articles. It also supports the synchronization "
"of the tickets with a foreign database, which can be used to import the "
"history of the tickets."
msgstr ""

